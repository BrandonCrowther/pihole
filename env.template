# Copy this file to .env and adjust for your host / LAN.
# DO NOT commit .env — it is gitignored and may hold your admin password.

# Timezone: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=America/Halifax

# Pi-hole web admin password (REQUIRED — compose refuses to start without it).
PASSWORD=

# Web UI port. With host networking this is the real host port.
WEB_PORT=8314

# This server's own static LAN IP (used for the *.pi shortcut). Should be a
# static address OUTSIDE the DHCP pool below.
SERVER_IP=192.168.2.2

# --- DHCP server ------------------------------------------------------------
# Set DHCP_ACTIVE=false if another device (e.g. your router) serves DHCP.
DHCP_ACTIVE=true
DHCP_START=192.168.2.10
DHCP_END=192.168.2.199
DHCP_ROUTER=192.168.2.1
DHCP_LEASE=24h

# Upstream resolvers: local unbound first, Cloudflare (1.1.1.1) as fallback.
DNS_UPSTREAMS=127.0.0.1#5335;1.1.1.1
